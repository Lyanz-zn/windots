{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/logo.txt",
    "type": "file-raw",
    "color": {
      "1": "white",
      "2": "white"
    },
    "padding": {
      "left": 2,
      "top": 2
    }
  },
  "display": {
    "separator": "  ",
    "color": "white"
  },
  "modules": [
    "break",
    "break",
    {
      "type": "custom",
      "format": "\u001b[36m Whoami"
    },
    {
      "type": "users",
      "key": "└",
      "keyColor": "cyan",
      "format": "{name}"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[92m Hardware"
    },
    {
      "type": "host",
      "key": "├󰌢",
      "keyColor": "green",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "├",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "├󰻠",
      "keyColor": "green",
      "format": "{name}, {cores-physical}C {cores-logical}T"
    },
    {
      "type": "gpu",
      "key": "└󰍛",
      "keyColor": "green",
      "format": "{name}"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[94m󰅪 Others"
    },
    {
      "type": "shell",
      "key": "├",
      "keyColor": "blue",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": "├󰌢",
      "keyColor": "blue",
      "format": "{pretty-name}"
    },
    {
      "type": "packages",
      "key": "└󰏖",
      "keyColor": "blue",
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[95m󰚭 Uptime"
    },
    {
      "type": "uptime",
      "key": "└󰞌",
      "keyColor": "magenta"
    },
    "break"
  ]
}
